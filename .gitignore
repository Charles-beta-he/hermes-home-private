# Hermes local runtime / secret boundary
# This repository may track skills, scripts, profiles, and governance docs.
# It must not track runtime credentials, sessions, cache, or transient tick artifacts.

# Secrets and auth material
.env
.env.*
!.env.example
auth.json
shared/
credentials/
secrets/
*.pem
*.key
*.p12
*.pfx

# Conversation/session/runtime state
sessions/
state/
task_ledger.db
*.db-wal
*.db-shm

# Browser/cache/media artifacts
cache/
tmp/
*.log
*.log.*
*.pid
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated media/cache artifacts
# Approved 2026-06-04 after reference-check gate:
# docs/private/dirty-reference-check-20260604/manual-gate-packet.md
# Do not delete existing artifacts implicitly; this only keeps generated cache output untracked.
media/generated/

# Cron/generated runtime output
cron/output/

# Disposable runtime logs only (audit/evidence logs stay visible/manual-gated).
# Approved 2026-06-04 after runtime log classification.
logs/*.jsonl
logs/curator/
logs/diagnostics-fixes.jsonl
logs/hermes-failure-taxonomy.jsonl
logs/integration-test-integration-test-*.json
logs/iteration_budget_triage.jsonl
logs/local_brain_html_refresh.jsonl
logs/model-quota.jsonl
logs/model-routing.jsonl
logs/multi-brain-nightly-safe.jsonl
logs/multi-model-smoke-daily-full-wrapper.jsonl
logs/multi-model-smoke-every4h-wrapper.jsonl
logs/multi-model-smoke.jsonl
logs/multimodel_intervention_dynamic_step.jsonl
logs/observed_worker.jsonl
logs/observer_hook.jsonl
logs/planner-failure-triage.jsonl
logs/route_outcome_hook.jsonl
logs/synthetic-trace-ratio-guard.jsonl
logs/taskpool-multimodel/
logs/taskpool-workers/
logs/upstream-ratchet-review-timeouts.jsonl

# Checkpoints, ticks, snapshots, generated proof/runtime dirs
checkpoints/
snapshots/
tick-*/
stash-archive/

# Local usage/accounting and volatile generated files
.hermes_history
.skills_prompt_snapshot.json
.update_check
channel_directory.json
skills/.usage.json
skills/.usage.json.lock
skills/.curator_state
skills/.curator_backups/

# Profile-local secrets, preferences, and live runtime state.
# Keep local files on disk, but do not continue versioning live drift.
config.yaml
config/quorum.yaml
memories/
cron/jobs.json
gateway.lock
gateway_state.json
context_length_cache.yaml
models_dev_cache.json
ollama_cloud_models_cache.json
route_outcomes.db
state.db
state.db.bak.*
state-snapshots/

# Local control-plane runtime queues/evidence and scratch prompts.
task-observer/
task-preflight/
task-progress/
task-worker/
taskpool-followthrough/
taskpool/
taskpool_evidence/
taskpool_repair_evidence/
tasks/
tmp-*
vendor/
worktrees/

# Evidence policy:
# Keep durable evidence only through explicit manifest-backed docs/private or evidence manifests.
# Raw screenshots should stay untracked unless a review explicitly promotes them.
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.jpeg
evidence/**/*.webp
evidence/**/*.mp4
evidence/**/*.mov

# Do NOT ignore canonical source directories:
# scripts/, skills/, project-profiles/, docs/private/
