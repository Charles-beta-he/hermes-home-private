{
  "schema_version": 1,
  "workflow_id": "mini-program-game-factory",
  "closure_states": [
    "source_registry",
    "market_snapshot",
    "unranked_lead",
    "recent_market_lead",
    "stale_lead",
    "verified_current_hot",
    "mechanic_observed",
    "trend_clustered",
    "market_to_kernel_gate_evaluated",
    "kernel_hypothesis",
    "seed",
    "kernel_draft",
    "kernel_verified",
    "content_candidate",
    "work_package_compiled",
    "cocos_integration_planned",
    "cocos_candidate_materialized",
    "node_runtime_smoke_passed",
    "official_platform_adapter_contract_tested",
    "creator_project_candidate_materialized",
    "build_preflight_blocked",
    "ready_to_build",
    "runtime_verified",
    "creator_build_verified",
    "devtools_handoff_receipt_integrity_verified",
    "human_accepted",
    "platform_ready",
    "published",
    "observing",
    "stopped"
  ],
  "nodes": [
    {
      "id": "market-observatory",
      "kind": "workflow",
      "responsibility": "collect time-bounded rank, propagation and gameplay evidence without promoting model inference to market fact",
      "consumes": [
        "source_registry",
        "direct_rank_capture",
        "direct_gameplay_capture",
        "public_market_source"
      ],
      "produces": [
        "market_snapshot",
        "mechanic_observations",
        "market_evidence_receipt"
      ],
      "side_effects": "external_read_and_local_write",
      "gates": [
        "freshness",
        "canonical-source-registry",
        "canonical-evidence-level",
        "source-reference",
        "subject-binding",
        "independent-lineages",
        "local-digest-readback",
        "no-symlink-local-media",
        "human-media-content-review",
        "distinct-role-media",
        "direct-gameplay-freshness",
        "direct-gameplay",
        "clean-room-boundary"
      ]
    },
    {
      "id": "trend-synthesis",
      "kind": "workflow",
      "responsibility": "deduplicate products and cluster abstract mechanics across sources and observation periods",
      "consumes": [
        "mechanic_observations",
        "market_evidence_receipt"
      ],
      "produces": [
        "trend_clusters",
        "kernel_hypothesis_candidates"
      ],
      "depends_on": [
        "market-observatory"
      ],
      "side_effects": "local_write",
      "gates": [
        "dedupe",
        "cross-period-support",
        "non-copyable-expression-exclusion",
        "human-review"
      ]
    },
    {
      "id": "market-to-kernel-gate",
      "kind": "gate",
      "responsibility": "admit only hypotheses backed by verified_current_hot observations while keeping kernel freeze, work-package compilation and release authority closed",
      "consumes": [
        "market_evidence_receipt",
        "kernel_hypothesis_candidates",
        "model_routing_contract"
      ],
      "produces": [
        "kernel_hypotheses",
        "market_loop_receipt"
      ],
      "depends_on": [
        "market-observatory",
        "trend-synthesis"
      ],
      "side_effects": "local_write",
      "gates": [
        "verified-current-hot",
        "observation-reference",
        "canonical-model-routing",
        "protected-surface",
        "non-copyable-expression-exclusion",
        "deterministic-receipt"
      ]
    },
    {
      "id": "idea-intake",
      "kind": "atomic_module",
      "responsibility": "normalize an opportunity into a testable gameplay hypothesis",
      "consumes": [
        "user_seed",
        "source_evidence",
        "trend_clusters",
        "kernel_hypotheses"
      ],
      "produces": [
        "gameplay_hypothesis"
      ],
      "depends_on": [
        "market-to-kernel-gate"
      ],
      "side_effects": "none",
      "gates": [
        "source-boundary",
        "market-status-boundary",
        "differentiation"
      ]
    },
    {
      "id": "kernel-design",
      "kind": "workflow",
      "responsibility": "define deterministic rules independent of theme and platform",
      "consumes": [
        "gameplay_hypothesis"
      ],
      "produces": [
        "gameplay_kernel"
      ],
      "depends_on": [
        "idea-intake"
      ],
      "subnodes": [
        "state-model",
        "action-model",
        "win-lose-model",
        "golden-cases"
      ],
      "side_effects": "local_write",
      "gates": [
        "kernel-schema",
        "determinism",
        "golden-cases"
      ]
    },
    {
      "id": "content-factory",
      "kind": "workflow",
      "responsibility": "generate theme and level content against a frozen kernel",
      "consumes": [
        "gameplay_kernel",
        "content_seed"
      ],
      "produces": [
        "content_pack_candidates"
      ],
      "depends_on": [
        "kernel-design"
      ],
      "subnodes": [
        "theme",
        "copy",
        "level-params",
        "asset-brief",
        "rights-metadata"
      ],
      "side_effects": "local_write",
      "gates": [
        "content-schema",
        "protected-surface",
        "parameter-bounds",
        "rights",
        "dedupe"
      ]
    },
    {
      "id": "work-package-compiler",
      "kind": "adapter",
      "responsibility": "compile frozen kernel plus approved content into deterministic implementation packets",
      "consumes": [
        "gameplay_kernel",
        "content_pack",
        "model_route"
      ],
      "produces": [
        "work_package"
      ],
      "depends_on": [
        "kernel-design",
        "content-factory"
      ],
      "side_effects": "local_write",
      "gates": [
        "canonical-model-routing",
        "deterministic-compile",
        "candidate-only-until-promotion-receipt",
        "provenance"
      ]
    },
    {
      "id": "cocos-integration",
      "kind": "adapter",
      "responsibility": "map a digest-valid engine-neutral work package into a deterministic local Cocos Creator 3.8 candidate without invoking Creator or platform tools",
      "consumes": [
        "work_package",
        "cocos_integration_profile"
      ],
      "produces": [
        "cocos_integration_packet",
        "cocos_candidate_manifest"
      ],
      "depends_on": [
        "work-package-compiler"
      ],
      "side_effects": "local_candidate_write",
      "gates": [
        "source-compile-digest",
        "pinned-cocos-source",
        "candidate-only",
        "authority-closed",
        "no-symlink-output",
        "deterministic-materialization"
      ]
    },
    {
      "id": "gameplay-runtime-core",
      "kind": "runtime",
      "responsibility": "execute deterministic gameplay facts and candidate ContentPack normalization without Cocos Presentation or official platform SDK claims",
      "consumes": [
        "cocos_candidate_manifest",
        "gameplay_kernel",
        "content_pack"
      ],
      "produces": [
        "node_runtime_smoke_receipt",
        "platform_stub_results"
      ],
      "depends_on": [
        "cocos-integration"
      ],
      "side_effects": "local_process",
      "gates": [
        "strict-typescript",
        "fixed-seed",
        "state-digest",
        "official-sdk-false",
        "reward-not-granted"
      ]
    },
    {
      "id": "cocos-project-generator",
      "kind": "generator",
      "responsibility": "materialize and verify a deterministic Creator 3.8 import candidate while keeping runtime/build authority closed",
      "consumes": [
        "cocos_candidate_manifest",
        "node_tested_runtime_sources",
        "pinned_serialization_reference"
      ],
      "produces": [
        "creator_project_candidate",
        "project_manifest"
      ],
      "depends_on": [
        "gameplay-runtime-core"
      ],
      "side_effects": "local_candidate_write",
      "gates": [
        "complete-file-manifest",
        "sha256-readback",
        "no-symlink-files",
        "typescript-typecheck",
        "creator-import-pending"
      ]
    },
    {
      "id": "cocos-build-preflight",
      "kind": "gate",
      "responsibility": "produce a non-executing exact build plan only when project digest, serialization reference, non-symlink Creator executable bytes, exact editor 3.8.x patch readback, editor-exported config bytes, AppID presence and explicit build authority converge",
      "consumes": [
        "project_manifest",
        "serialization_creator_version",
        "creator_executable",
        "creator_executable_sha256",
        "creator_editor_version_readback",
        "editor_exported_build_config",
        "build_config_sha256",
        "appid_presence",
        "build_authority"
      ],
      "produces": [
        "build_preflight_receipt",
        "ready_to_build_or_blocked"
      ],
      "depends_on": [
        "cocos-project-generator"
      ],
      "side_effects": "none",
      "gates": [
        "project-digest",
        "serialization-version-boundary",
        "creator-cli",
        "exact-editor-patch-readback",
        "executable-digest",
        "config-target-appid-binding",
        "config-digest",
        "no-secret-output",
        "exact-authority"
      ]
    },
    {
      "id": "devtools-handoff-verifier",
      "kind": "gate",
      "responsibility": "verify project serialization identity, exact editor patch/executable/config build binding, artifact digest and supplied human Creator/DevTools/simulator/device readbacks without granting upload, review or publish authority",
      "consumes": [
        "creator_build_artifact",
        "human_handoff_receipt",
        "serialization_creator_version",
        "creator_editor_version_readback",
        "creator_executable_sha256",
        "build_config_sha256"
      ],
      "produces": [
        "devtools_handoff_receipt_integrity_verified"
      ],
      "depends_on": [
        "cocos-creator-build"
      ],
      "side_effects": "read_only",
      "gates": [
        "strict-fields",
        "serialization-editor-version-separation",
        "exact-editor-patch-binding",
        "creator-executable-sha256",
        "build-config-sha256",
        "artifact-sha256",
        "platform-target-project-binding",
        "real-device-readback",
        "no-open-authority",
        "external-stages-not-started"
      ]
    },
    {
      "id": "implementation",
      "kind": "workflow",
      "responsibility": "implement bounded vertical slices from frozen work packages",
      "consumes": [
        "work_package"
      ],
      "produces": [
        "code",
        "tests",
        "runtime_receipt"
      ],
      "depends_on": [
        "gameplay-runtime-core"
      ],
      "side_effects": "local_write",
      "gates": [
        "tests",
        "runtime-smoke",
        "performance"
      ]
    },
    {
      "id": "cocos-creator-build",
      "kind": "gate",
      "responsibility": "require an exact Creator installation, official build target and digest-bound build receipt before any platform artifact claim",
      "consumes": [
        "ready_to_build",
        "serialization_creator_version",
        "creator_editor_version_readback",
        "creator_executable_sha256",
        "build_config_sha256",
        "editor_exported_build_config"
      ],
      "produces": [
        "creator_build_receipt",
        "platform_build_candidate"
      ],
      "depends_on": [
        "cocos-build-preflight"
      ],
      "side_effects": "local_process_requires_exact_authority",
      "gates": [
        "creator-installation-readback",
        "serialization-editor-version-separation",
        "exact-editor-patch-binding",
        "executable-and-config-digests",
        "official-build-target",
        "creator-cli-success-exit-36",
        "artifact-digest"
      ]
    },
    {
      "id": "official-platform-adapter-candidate",
      "kind": "adapter",
      "responsibility": "provide local contract-tested wx/tt PlatformPort implementations without claiming official SDK E2E or opening runtime authority",
      "consumes": [
        "platform_port_contract",
        "wx_runtime_namespace_shape",
        "tt_runtime_namespace_shape"
      ],
      "produces": [
        "official_platform_adapter_contract_tested",
        "wechat_adapter_candidate",
        "douyin_adapter_candidate"
      ],
      "depends_on": [
        "gameplay-runtime-core"
      ],
      "side_effects": "none_until_explicit_runtime_instantiation",
      "gates": [
        "exact-wx-tt-global-binding",
        "runtime-sdk-shape-validation",
        "typed-sdk-errors",
        "one-time-login-code-not-identity",
        "reward-only-after-isEnded-true",
        "authority-closed"
      ]
    },
    {
      "id": "platform-adapter",
      "kind": "adapter",
      "responsibility": "activate a contract-tested adapter against a real official platform runtime only after build and DevTools/device evidence converge",
      "consumes": [
        "official_platform_adapter_contract_tested",
        "creator_build_artifact",
        "official_platform_runtime",
        "devtools_handoff_receipt_integrity_verified"
      ],
      "produces": [
        "platform_runtime_receipt",
        "platform_build"
      ],
      "depends_on": [
        "official-platform-adapter-candidate",
        "devtools-handoff-verifier"
      ],
      "side_effects": "official_sdk_runtime_calls_require_external_evidence_and_exact_authority",
      "gates": [
        "official-contract",
        "official-sdk-e2e",
        "typed-errors",
        "reward-idempotency",
        "real-device-readback",
        "exact-authority"
      ]
    },
    {
      "id": "release-gate",
      "kind": "gate",
      "responsibility": "block submission or publish until objective and human evidence converges",
      "consumes": [
        "platform_build",
        "evidence_bundle"
      ],
      "produces": [
        "ready_or_blocked"
      ],
      "depends_on": [
        "platform-adapter"
      ],
      "side_effects": "none",
      "outcomes": {
        "pass": "platform_ready",
        "warn": "review",
        "fail": "repair",
        "blocked": "human_gate"
      }
    }
  ],
  "agent_wrappers": [
    {
      "id": "cheap-market-extractor",
      "role": "creator",
      "wraps": [
        "market-observatory",
        "trend-synthesis"
      ],
      "authority": "local_candidate_write",
      "cannot_do": [
        "invent_evidence",
        "write_content_review",
        "promote_verified_hot",
        "freeze_kernel",
        "publish"
      ]
    },
    {
      "id": "cheap-content-worker",
      "role": "creator",
      "wraps": [
        "content-factory"
      ],
      "authority": "local_write",
      "cannot_do": [
        "modify_kernel",
        "modify_monetization",
        "modify_platform_contract",
        "publish"
      ]
    },
    {
      "id": "kernel-architect",
      "role": "creator",
      "wraps": [
        "kernel-design"
      ],
      "authority": "local_write",
      "cannot_do": [
        "self_certify",
        "publish"
      ]
    },
    {
      "id": "evidence-verifier",
      "role": "verifier",
      "wraps": [
        "market-to-kernel-gate",
        "work-package-compiler",
        "release-gate"
      ],
      "authority": "read_only",
      "cannot_do": [
        "repair_own_finding",
        "publish"
      ]
    }
  ],
  "cannot_prove": [
    "fun",
    "retention",
    "revenue",
    "platform_approval",
    "production_performance"
  ]
}
