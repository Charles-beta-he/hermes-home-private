{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Context Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "non_goals",
    "constraints",
    "sources",
    "selected_context",
    "authority",
    "execution_plan",
    "validation_plan",
    "negative_cases",
    "learning_boundary"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "locator",
          "claims"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "file",
              "url",
              "session",
              "tool_output",
              "screenshot",
              "api",
              "log",
              "profile",
              "skill"
            ]
          },
          "locator": {
            "type": "string"
          },
          "freshness": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "selected_context": {
      "type": "object",
      "required": [
        "skills",
        "memory",
        "project_profile",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_profile": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "allowed",
        "closed",
        "readback_required"
      ],
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "closed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readback_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "execution_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_boundary": {
      "type": "object",
      "required": [
        "durable_memory_allowed",
        "skill_update_allowed",
        "ssot_update_allowed",
        "do_not_save"
      ],
      "additionalProperties": false,
      "properties": {
        "durable_memory_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skill_update_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ssot_update_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_save": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}