{
  "schema": "hermes_capability_module_v1",
  "id": "lifecycle_promotion_cleanup_kernel",
  "title": "Lifecycle Promotion and Cleanup Kernel",
  "version": 1,
  "kind": "gate",
  "responsibility": "Govern seed→draft→candidate→validated→common→canonical plus quarantine/deprecation/finalizers.",
  "contracts": {
    "consumes": [
      "module_identity",
      "evidence_ledger",
      "route_eval_result"
    ],
    "produces": [
      "lifecycle_transition_decision",
      "cleanup_finalizers"
    ],
    "input_contract": {
      "required": [
        "module_identity",
        "evidence_ledger",
        "route_eval_result"
      ],
      "optional": []
    },
    "output_contract": {
      "produces": [
        "lifecycle_transition_decision",
        "cleanup_finalizers"
      ],
      "evidence_required": true,
      "confidence_required": true
    },
    "presentation_contract": {
      "surfaces": [
        "cli",
        "markdown"
      ],
      "style": "concise_evidence_first"
    }
  },
  "routing": {
    "applies_when": [
      "生命周期晋级清理",
      "promotion cleanup",
      "candidate validated canonical",
      "finalizer",
      "Govern seed→draft→candidate→validated→common→canonical plus quarantine/deprecation/finalizers."
    ],
    "does_not_apply_when": [
      "一次成功直接canonical",
      "删除前不扫描引用",
      "没有absorbed_into",
      "晚到异议不裁定"
    ],
    "positive_examples": [
      "生命周期晋级清理",
      "promotion cleanup",
      "candidate validated canonical",
      "finalizer"
    ],
    "negative_examples": [
      "一次成功直接canonical",
      "删除前不扫描引用",
      "没有absorbed_into",
      "晚到异议不裁定"
    ],
    "neighbor_modules": [
      "authority_evidence_gate_kernel",
      "capability_graph"
    ],
    "forbidden_triggers": [
      "workflow keyword alone",
      "temporary progress update",
      "single successful run without evidence"
    ]
  },
  "authority": {
    "side_effects": "none",
    "required_authority": [],
    "can_run_autonomously": true,
    "prohibited_side_effects": [
      "memory_write",
      "cron_write",
      "taskpool_lifecycle",
      "external_dispatch",
      "publish_deploy_push",
      "destructive",
      "credential_entry"
    ]
  },
  "lifecycle": {
    "maturity": "candidate",
    "retention": "global_reusable_candidate",
    "promotion_requires": [
      "route_eval_positive_negative",
      "fresh_evidence_contract",
      "neighbor_collision_scan",
      "cleanup_policy"
    ],
    "cleanup_policy": "quarantine_on_false_trigger; archive_or_absorb_when_superseded"
  },
  "metrics": {
    "usage_count": 0,
    "success_count": 0,
    "evidence_pass_rate": 0.0,
    "false_trigger_count": 0,
    "human_intervention_rate": 0.0
  },
  "promotion_policy": {
    "promote_when": [
      "successful_runs >= 2",
      "evidence_pass_rate >= 0.8",
      "negative_cases_pass"
    ],
    "demote_when": [
      "false_trigger",
      "stale_evidence",
      "user_correction"
    ],
    "cleanup_when": [
      "no_usage_for_ttl",
      "superseded_by_better_module"
    ]
  }
}
