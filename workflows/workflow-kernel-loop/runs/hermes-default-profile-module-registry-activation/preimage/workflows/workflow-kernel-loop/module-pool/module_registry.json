    {
      "schema": "hermes_capability_module_v1",
      "id": "authority_evidence_gate_kernel",
      "title": "Authority and Evidence Gate Kernel",
      "version": 1,
      "kind": "gate",
      "responsibility": "Fail-closed side-effect authorization and evidence/readback contracts before action and completion claims.",
      "contracts": {
        "consumes": [
          "proposed_action",
          "target",
          "side_effect_class",
          "authority_context"
        ],
        "produces": [
          "authority_decision",
          "evidence_contract",
          "readback_requirement"
        ],
        "input_contract": {
          "required": [
            "proposed_action",
            "target",
            "side_effect_class",
            "authority_context"
          ],
          "optional": []
        },
        "output_contract": {
          "produces": [
            "authority_decision",
            "evidence_contract",
            "readback_requirement"
          ],
          "evidence_required": true,
          "confidence_required": true
        },
        "presentation_contract": {
          "surfaces": [
            "cli",
            "markdown"
          ],
          "style": "concise_evidence_first"
        }
      },
      "routing": {
        "applies_when": [
          "权限证据门",
          "side effect gate",
          "evidence contract",
          "readback receipt",
          "Fail-closed side-effect authorization and evidence/readback contracts before action and completion claims."
        ],
        "does_not_apply_when": [
          "模型自称完成",
          "无精确target的外部发送",
          "凭旧证据声明完成",
          "credential/payment entry"
        ],
        "positive_examples": [
          "权限证据门",
          "side effect gate",
          "evidence contract",
          "readback receipt"
        ],
        "negative_examples": [
          "模型自称完成",
          "无精确target的外部发送",
          "凭旧证据声明完成",
          "credential/payment entry"
        ],
        "neighbor_modules": [
          "landing_zone_kernel",
          "readback_receipt"
        ],
        "forbidden_triggers": [
          "workflow keyword alone",
          "temporary progress update",
          "single successful run without evidence"
        ]
      },
      "authority": {
        "side_effects": "none",
        "required_authority": [],
        "can_run_autonomously": true,
        "prohibited_side_effects": [
          "memory_write",
          "cron_write",
          "taskpool_lifecycle",
          "external_dispatch",
          "publish_deploy_push",
          "destructive",
          "credential_entry"
        ]
      },
      "lifecycle": {
        "maturity": "candidate",
        "retention": "global_reusable_candidate",
        "promotion_requires": [
          "route_eval_positive_negative",
          "fresh_evidence_contract",
          "neighbor_collision_scan",
          "cleanup_policy"
        ],
        "cleanup_policy": "quarantine_on_false_trigger; archive_or_absorb_when_superseded"
      },
      "metrics": {
        "usage_count": 0,
        "success_count": 0,
        "evidence_pass_rate": 0.0,
        "false_trigger_count": 0,
        "human_intervention_rate": 0.0
      },
      "promotion_policy": {
        "promote_when": [
          "successful_runs >= 2",
          "evidence_pass_rate >= 0.8",
          "negative_cases_pass"
        ],
        "demote_when": [
          "false_trigger",
          "stale_evidence",
          "user_correction"
        ],
        "cleanup_when": [
          "no_usage_for_ttl",
          "superseded_by_better_module"
        ]
      }
    },
